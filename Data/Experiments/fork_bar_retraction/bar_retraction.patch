+    def Retract(self, command: Command_Str, step_name: str, log: np.ndarray, rows: tp.Sequence[int], qs: tp.List[np.ndarray]) -> tp.List[np.ndarray]:
+        """
+        Description:
+            A path's Bar_Retraction (F11): each recorded row posed with its MG06 state; every fork geom near the handle bar asks
+            to be Bar_Retraction off the bar along its fork-bar direction, fading out (cosine) to none where its recorded gap
+            reaches CONST_BAR_WINDOW; the row moves by the smallest sum that meets each (a geom's deficit added in turn, the
+            largest first: two faces of the slot both retract, two pieces of one face do not add); the moved rows solved by
+            flange IK again, seeded from the previous row.
+
+        Args:
+            (1) command [Command_Str(object)]: The MovePath.
+            (2) step_name [string]: The step.
+            (3) log [Matrix<float> nx11]: The recording.
+            (4) rows [List<int>]: Its rows.
+            (5) qs [List<Vector<float> 1x6>]: The start joints and each row's joints (rad).
+
+        Returns:
+            (1) parameter [List<Vector<float> 1x6>]: The joints with the moved rows solved again (rad).
+        """
+
+        kinematics = self.__kinematics
+        model, data = kinematics.Model, kinematics.Data
+        out, q = [qs[0]], qs[0]
+        for i, q_row in zip(rows, qs[1:]):
+            handle = float(log[i, 3])
+            kinematics.Set_Scene(data, lid=float(log[i, 1]), handle=handle, press=Press_For_Handle(model, handle))
+            data.qpos[kinematics.Q_Address] = q_row
+            mujoco.mj_kinematics(model, data)
+            asks = []
+            for gap, direction in Bar_Gaps(model, data):
+                weight = 1.0 if gap <= 0.0 else 0.0 if gap >= CONST_BAR_WINDOW else 0.5 * (1.0 + math.cos(math.pi * gap / CONST_BAR_WINDOW))
+                if weight > 0.0:
+                    asks.append((command.Bar_Retraction * weight, direction))
+            move = np.zeros(3)
+            for amount, direction in sorted(asks, key=lambda a: -a[0]):
+                move -= max(0.0, amount - float(move @ -direction)) * direction
+            if not asks:
+                q = q_row
+            else:
+                q, ok = kinematics.Solve_IK(log[i, 4:7] + move, Quaternion_To_Matrix(log[i, 7:11]), q, site=kinematics.Site_Flange, tol=CONST_IK_TOL,
+                                            w_null=0.0)
+                if not ok:
+                    self.Fail(step_name, command.Text, 'flange IK did not converge at recorded row %d moved off the bar.' % i)
+            out.append(q.copy())
+        return out
