+def Bar_Gaps(model: mujoco.MjModel, data: mujoco.MjData) -> tp.List[tp.Tuple[float, np.ndarray]]:
+    """
+    Description:
+        Each fork geom's exact distance to the MG06 handle bar in the data's current kinematics (negative: an overlap) and the
+        unit direction from the fork to the bar there, for the geoms within CONST_REPORT_CUT, by geom (F11).
+
+    Args:
+        (1 - 2) model, data [mujoco.MjModel, mujoco.MjData]: The model and its posed data.
+
+    Returns:
+        (1) parameter [List<Tuple<float, Vector<float> 1x3>>]: (distance (m), direction (world)) per fork geom near the bar.
+    """
+
+    bar = model.geom('handle_bar').id
+    fork = model.body('aubo/tool/ee_tool').id
+    out, ft = [], np.zeros(6)
+    for g in (g for g in range(model.ngeom) if model.geom_bodyid[g] == fork and model.geom_contype[g]):
+        x = mujoco.mj_geomDistance(model, data, g, bar, CONST_REPORT_CUT, ft)
+        if x < CONST_REPORT_CUT:
+            # The witness points run from the fork to the bar; an overlap reverses them, so the sign of x restores the side.
+            v = math.copysign(1.0, x) * (ft[3:] - ft[:3])
+            out.append((float(x), v / (np.linalg.norm(v) or 1.0)))
+    return out
+
+
+def Bar_Gap(model: mujoco.MjModel, data: mujoco.MjData) -> float:
+    """
+    Description:
+        The fork's smallest exact distance to the MG06 handle bar (Bar_Gaps; CONST_REPORT_CUT when farther).
+
+    Args:
+        (1 - 2) model, data [mujoco.MjModel, mujoco.MjData]: The model and its posed data.
+
+    Returns:
+        (1) parameter [float]: The distance (m).
+    """
+
+    return min([x for x, _ in Bar_Gaps(model, data)] + [CONST_REPORT_CUT])
+
