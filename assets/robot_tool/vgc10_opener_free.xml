    <mesh name="tool_vis_14" file="tool/vis_14.stl" inertia="shell"/>
    <mesh name="tool_vis_15" file="tool/vis_15.stl" inertia="shell"/>
    <mesh name="tool_vis_16" file="tool/vis_16.stl" inertia="shell"/>
