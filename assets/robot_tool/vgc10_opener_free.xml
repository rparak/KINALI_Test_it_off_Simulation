    <mesh name="tool_vis_28" file="tool/vis_28.stl" inertia="shell"/>
    <mesh name="tool_vis_opener" file="tool/vis_opener.stl" inertia="shell"/>
    <mesh name="tool_col_opener_00" file="tool/col_opener_00.stl"/>
    <mesh name="tool_col_opener_01" file="tool/col_opener_01.stl"/>
    <mesh name="tool_col_opener_02" file="tool/col_opener_02.stl"/>
