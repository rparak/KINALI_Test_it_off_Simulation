<mujoco model="vgc10_opener">
  <!-- OnRobot VGC10 + fork "opener" (from untitled.blend).
       Body origin = robot flange (tool0), +Z = tool axis towards the suction cups.
       (test variant with a free joint, driven by a mocap weld)
       Attach: put <body name="ee_tool"> under the robot's flange/attachment body (or use the MjSpec attach API). -->
  <compiler angle="radian" meshdir="assets" autolimits="true"/>
  <default>
    <default class="tool">
      <default class="tool_visual"><geom type="mesh" contype="0" conaffinity="0" group="2" density="0"/></default>
      <default class="tool_collision"><geom type="mesh" group="3" density="0" friction="0.6 0.01 0.0001" condim="3" rgba=".9 .4 .1 .4"/></default>
    </default>
  </default>
  <asset>
    <mesh name="tool_vis_00" file="tool/vis_00.stl" inertia="shell"/>
