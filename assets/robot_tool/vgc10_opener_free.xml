      <geom class="tool_collision" mesh="tool_col_opener_11"/>
      <geom class="tool_collision" mesh="tool_col_opener_12"/>
      <geom class="tool_collision" mesh="tool_col_opener_13"/>
      <geom class="tool_collision" mesh="tool_col_opener_14"/>
      <geom class="tool_collision" mesh="tool_col_opener_15"/>
      <!-- simple primitives for the gripper body and the suction cups -->
      <geom class="tool_collision" type="box" size="0.05 0.05 0.096" pos="0 0 0.091"/>
      <geom class="tool_collision" type="box" size="0.0525 0.0293 0.039" pos="0 0 0.2215"/>
      <site name="tool_flange" pos="0 0 0" size="0.006" rgba="1 1 0 1" group="4"/>
      <!-- centre of the fork slot: bar centre sits here when engaged; slot opens towards +Y, bottom at y=0.048 -->
      <site name="fork_center" pos="0.12 0.07 0.015" size="0.006" rgba="0 1 0 1" group="4"/>
      <site name="suction_tcp" pos="0 0 0.2606" size="0.006" rgba="0 .6 1 1" group="4"/>
